@using EncoreTix.ViewModels
@model AttractionSearchViewModel
@{
    ViewData["Title"] = "Home Page";
}
<nav class="navbar navbar-light bg-light mx-auto">
    <div class="container-fluid mx-auto">
        <form class="d-flex mx-auto" asp-action="Index">
            <input class="form-control me-2 search-input" name="searchKeyword" type="search" placeholder="@Model.PreviousKeyword" aria-label="Search">
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
    </div>
</nav>
<div class="flex-column">
    @if (Model.Embedded?.Attractions?.Count > 0)
    {
        @foreach (var attraction in Model.Embedded.Attractions)
        {
            <div class="card mx-auto" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-4">
                        @if (attraction.Images != null && attraction.Images.Any())
                        {
                            var image = attraction.Images.FirstOrDefault(i => i.Ratio == "16_9") ?? attraction.Images.FirstOrDefault();
                            @if (image != null)
                            {
                                <img src="@image.Url" alt="@attraction.Name" style="height: 90px; width: 160px; object-fit: cover;">
                            }
                        }
                        else
                        {
                            <img src="..." class="img-fluid rounded-start" alt="...">
                        }
                    </div>
                    <div class="col-8">
                        <form asp-action="AttractionEvents" id="attractionForm">
                            <input type="hidden" name="attractionId" value="@attraction.Id" />
                            <input type="hidden" name="attractionName" value="@attraction.Name" />
                            @if (attraction.ExternalLinks != null)
                            {
                                <input type="hidden" name="twitterUrl" value="@attraction.ExternalLinks.Twitter?.FirstOrDefault()?.Url" />
                                <input type="hidden" name="youTubeUrl" value="@attraction.ExternalLinks.YouTube?.FirstOrDefault()?.Url" />
                                <input type="hidden" name="spotifyUrl" value="@attraction.ExternalLinks.Spotify?.FirstOrDefault()?.Url" />
                                <input type="hidden" name="homePageUrl" value="@attraction.ExternalLinks.Homepage?.FirstOrDefault()?.Url" />
                            }
                        </form>
                        <a class="page-link" href="#" onclick="document.getElementById('attractionForm').submit(); return false;">
                            <div class="card-body">
                                <h5 class="">@attraction.Name</h5>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="container d-flex justify-content-center align-items-center" style="max-width: 30rem; height: 30vh;">
            <div class="bg-white rounded-3 d-flex flex-column justify-content-center align-items-center p-3" style="height: 20vh; width: 100%;">
                <img src="~/sadface_icon.png" class="mb-2" alt="Sad face" style="max-height: 40px;">
                <p class="text-center mb-0 text-primary">No results found for "@Model.PreviousKeyword". Please try a different search.</p>
            </div>
        </div>
    }
</div>